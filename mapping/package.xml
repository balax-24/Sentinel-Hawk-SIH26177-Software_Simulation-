<?xml version="1.0"?>
<package format="3">
  <name>sih_mapping</name>
  <version>0.1.0</version>
  <description>3D environment reconstruction and global point cloud map accumulation for SIH26177.</description>
  <maintainer email="team@sih26177.org">SIH26177 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
