<?xml version="1.0" ?>
<!-- SIH26177 Search-and-Rescue Quadrotor UAV Model for Ignition Gazebo Fortress -->
<sdf version="1.8">
  <model name="sih_uav">
    <pose>0 0 0.3 0 0 0</pose>
    <static>false</static>

    <!-- Main Airframe Base Link -->
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.028125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.028125</iyy>
          <iyz>0</iyz>
          <izz>0.050625</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.45 0.45 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.45 0.45 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <visual name="arm_cross_1">
        <pose>0 0 0 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.60 0.04 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.3 0.1 1</ambient> <!-- SAR High-Visibility Orange Accent -->
          <diffuse>0.85 0.3 0.1 1</diffuse>
        </material>
      </visual>

      <visual name="arm_cross_2">
        <pose>0 0 0 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.60 0.04 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- 1. 3D LiDAR Sensor Mounted on UAV Top Deck -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <pose>0 0 0.10 0 0 0</pose>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>512</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>  <!-- -15 deg -->
              <max_angle>0.261799</max_angle>   <!-- +15 deg -->
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>50.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>

      <!-- 2. Forward/Downward Gimbaled RGB Camera -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.15 0 0.0 0 0.35 0</pose> <!-- 20 deg pitch down for SAR inspection -->
        <topic>/camera/image</topic>
        <camera>
          <horizontal_fov>1.085595</horizontal_fov> <!-- ~62.2 deg FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- 3. 6-Axis IMU Sensor -->
      <sensor name="drone_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <topic>/drone/imu/data</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 4. GPS / GNSS Sensor -->
      <sensor name="drone_gps" type="navsat">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <pose>0 0 0.08 0 0 0</pose>
        <topic>/drone/gps/fix</topic>
      </sensor>
    </link>

    <!-- 5. Velocity Control Plugin for Direct Twist Movement -->
    <plugin
      filename="ignition-gazebo-velocity-control-system"
      name="ignition::gazebo::systems::VelocityControl">
      <topic>/model/sih_uav/cmd_vel</topic>
    </plugin>

    <!-- 6. Odometry Publisher Plugin (Publishes odometry with pose and twist) -->
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/model/sih_uav/odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <!-- 7. Model Pose Publisher Plugin -->
    <plugin
      filename="ignition-gazebo-pose-publisher-system"
      name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

  </model>
</sdf>
